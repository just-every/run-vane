{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "analytics/vane",
    "name": "Vane",
    "sourceRepository": "https://github.com/just-every/run-vane",
    "license": "MIT",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "vane-worker-artifact.json"
    },
    "operations": {
      "setup": "pnpm install --frozen-lockfile",
      "build": "pnpm run build",
      "verify": "pnpm run check:deployment-spec && pnpm run verify",
      "artifact": "node scripts/delivery/base/cli.mjs artifact --config packaging.json",
      "recovery": "Follow OPERATIONS.md: stop collection, report schedules and imports; export the stopped installation with rer export, retain source and private configuration, restore with rer import into an empty installation, and verify owner access, site history and a re-export before routing traffic. Preserve every applied migration name and byte."
    },
    "verification": {
      "migrationDirectories": [
        "migrations/core"
      ]
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@34cf6c23b5cb86eff0068049bc39feeb38c8ffa9",
    "artifactFile": "vane-worker-artifact.json",
    "buildProfile": "project",
    "verificationProfiles": [
      "full"
    ]
  },
  "artifact": {
    "specInputs": {
      "publicVariableNames": [
        "AUTH_ORIGIN",
        "OWNER_EMAIL",
        "IDENTITY_PROVIDER",
        "MAIL_PROVIDER",
        "MAIL_FROM",
        "MAIL_RELAY_URL",
        "MAIL_ACCOUNT_ID"
      ],
      "secretNames": [
        "SESSION_SECRET",
        "SETUP_TOKEN"
      ],
      "optionalSecretNames": [
        "MAIL_API_KEY",
        "MAIL_WEBHOOK_KEY",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "SLACK_CLIENT_ID",
        "SLACK_CLIENT_SECRET",
        "AI_API_KEY",
        "OIDC_TRANSACTION_SECRET",
        "VANE_OIDC_PROVIDERS",
        "VANE_SAML_CONFIG"
      ],
      "healthPath": "/health",
      "recovery": "Follow OPERATIONS.md: stop collection, report schedules and imports; export the stopped installation with rer export, retain source and private configuration, restore with rer import into an empty installation, and verify owner access, site history and a re-export before routing traffic. Preserve every applied migration name and byte.",
      "providerEffects": [
        "outbound-mail"
      ],
      "mail": {
        "providers": [
          "rer",
          "resend",
          "sendgrid",
          "cloudflare"
        ]
      },
      "surfaces": {
        "app": {
          "path": "/app",
          "originVariable": "AUTH_ORIGIN",
          "signIn": {
            "path": "/signin",
            "loginHint": false,
            "ownerSignIn": "/auth/owner-claim"
          }
        }
      }
    }
  },
  "setup": {
    "manifestFile": "rer-setup.json"
  }
}
