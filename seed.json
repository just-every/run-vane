{
  "id": "vane",
  "name": "Vane",
  "version": "0.1.0",
  "maturity": "first-release-candidate",
  "category": "analytics",
  "spine": {
    "id": "foundation",
    "record": "Approved site configuration and anonymous page-load history"
  },
  "description": "Cookie-free website visits, sources, campaigns and goals with portable history.",
  "capabilities": [
    {
      "id": "http-dispatch",
      "clauses": [
        "HTTP-001"
      ]
    }
  ],
  "nonGoals": [
    "Visitor fingerprinting",
    "Session replay",
    "Advertising attribution"
  ],
  "externals": [
    {
      "id": "cloudflare",
      "required": true,
      "why": "Worker hosting",
      "data": [
        "HTTP requests"
      ],
      "adapters": []
    },
    {
      "id": "warehouse",
      "required": false,
      "why": "The owner's scheduled warehouse export (API-002) to their own Amazon S3 or Cloudflare R2 bucket",
      "data": [
        "Daily rollups",
        "Event rows without the visitor hash"
      ],
      "adapters": []
    }
  ],
  "env": [],
  "deploy": {
    "healthPath": "/health",
    "publicPaths": [
      "/",
      "/health",
      "/signin",
      "/methodology"
    ],
    "notes": "Native owner sessions guard /app; unknown paths return real 404s; the development outbox is local-only."
  },
  "extensionPoints": {
    "contributions": [],
    "policies": [],
    "events": [],
    "slots": [],
    "adapters": []
  },
  "limits": {
    "status": "unmeasured"
  },
  "accessibility": {
    "level": "WCAG 2.2 AA",
    "status": "target; unaudited"
  },
  "operatingCost": {
    "status": "unmeasured"
  },
  "composition": {
    "base": "base",
    "family": "analytics",
    "edition": "vane",
    "modules": [
      "job-queue",
      "release",
      "deploy-kit",
      "container",
      "demo-host",
      "integrations",
      "mail",
      "ai",
      "portability",
      "erasure",
      "dependencies",
      "operator-auth",
      "owner-claim"
    ]
  }
}
